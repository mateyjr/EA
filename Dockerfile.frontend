# Stage 1: build React static files
FROM node:20-alpine AS build
WORKDIR /app
ARG REACT_APP_BACKEND_URL=https://boteams-test.bot.go.tz
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

# Copy manifests. yarn.lock* glob makes the lock file optional
# (the runner will regenerate it if missing).
COPY frontend/package.json frontend/yarn.lock* ./
RUN if [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile --network-timeout 300000; \
    else \
      yarn install --network-timeout 300000; \
    fi

COPY frontend/ ./
RUN yarn build

# Stage 2: serve with nginx
FROM nginx:1.27-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q --spider http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
